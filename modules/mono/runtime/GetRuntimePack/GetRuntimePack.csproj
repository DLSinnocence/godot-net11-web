<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <!-- All .NET 11 targets use the CoreCLR runtime packs. -->
    <UseMonoRuntime>false</UseMonoRuntime>
    <OutputType>Exe</OutputType>
    <AssemblyName>GodotSharp</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'browser-wasm'">
    <WasmEnableThreads>false</WasmEnableThreads>
    <WasmEnableExceptionHandling>true</WasmEnableExceptionHandling>
    <WasmEnableSIMD>true</WasmEnableSIMD>
    <WasmBuildNative>true</WasmBuildNative>
  </PropertyGroup>
  <ItemGroup>
    <TrimmerRootAssembly Include="$(TargetName)" />
    <TrimmerRootAssembly Include="System.Private.CoreLib" />
  </ItemGroup>
  <Target Name="EchoRuntimeLocation" AfterTargets="ResolveFrameworkReferences">
    <Error Condition="'$(RuntimeIdentifier)' == ''" Text="Need to set RuntimeIdentifier to the target platform RID" />
    <ItemGroup>
      <CoreClrRuntimePack Include="@(ResolvedRuntimePack)" Condition="'%(ResolvedRuntimePack.FrameworkName)' == 'Microsoft.NETCore.App'" />
    </ItemGroup>
    <Error Condition="@(CoreClrRuntimePack->Count()) != 1" Text="Expected exactly one Microsoft.NETCore.App runtime pack, got @(CoreClrRuntimePack->Count())" />
    <PropertyGroup>
      <RuntimePackName>@(CoreClrRuntimePack)</RuntimePackName>
    </PropertyGroup>
    <Error Condition="!$(RuntimePackName.Contains('Microsoft.NETCore.App.Runtime.'))" Text="Expected '@(CoreClrRuntimePack)' to be a CoreCLR runtime pack." />
    <Message Importance="High" Text="Runtime pack %(CoreClrRuntimePack.Identity) is in: %(CoreClrRuntimePack.PackageDirectory)" />
    <WriteLinesToFile Overwrite="true" File="bin\$(RuntimeIdentifier)\runtime-pack-dir.txt" Lines="%(CoreClrRuntimePack.PackageDirectory)" />
  </Target>
</Project>
