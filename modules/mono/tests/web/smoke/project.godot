; Minimal project used only by the browser-wasm smoke fixture.
config_version=5

[application]

config/name="Godot Web CoreCLR Smoke"
run/main_scene="res://Smoke.tscn"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=640
window/size/window_height_override=360

[dotnet]

project/assembly_name="GodotWebSmoke"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
