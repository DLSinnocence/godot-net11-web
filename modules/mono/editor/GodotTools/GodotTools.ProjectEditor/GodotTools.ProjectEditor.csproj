<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ProjectGuid>{A8CDAD94-C6D4-4B19-A7E7-76C53CC92984}</ProjectGuid>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Build" Version="15.1.548" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Build.Locator" Version="1.11.2" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.0" PrivateAssets="All" />
    <!-- ProjectUtils uses NuGet.Frameworks independently of MSBuild. Restore it privately,
         then copy the explicit reference to GodotTools and include it in its .deps.json. -->
    <PackageReference Include="NuGet.Frameworks" Version="6.12.1" ExcludeAssets="all" PrivateAssets="all" GeneratePathProperty="true" />
    <Reference Include="NuGet.Frameworks" HintPath="$(PkgNuGet_Frameworks)/lib/netstandard2.0/NuGet.Frameworks.dll" Private="true" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GodotTools.Core\GodotTools.Core.csproj" />
    <ProjectReference Include="..\GodotTools.Shared\GodotTools.Shared.csproj" />
  </ItemGroup>

</Project>
